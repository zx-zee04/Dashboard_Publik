# Salin file ini menjadi .env dan sesuaikan dengan URL backend Anda
# Untuk website dan APK publik, ganti localhost dengan domain HTTPS backend ngrok.
# Contoh: VITE_API_URL=https://domain-anda.ngrok-free.dev
# Gunakan URL tunnel ke port 8000, tanpa /api di akhir; jangan gunakan URL frontend.
# npm run build:android menolak URL lokal agar APK dapat dipakai di HP lain.
VITE_API_URL=http://localhost:8000
